# Caddy gets and renews the Let's Encrypt certificate on its own
# once the domain's DNS points at this server.
{$SITE_DOMAIN} {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
